// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`link and journey day statements (postgres) > are one statement each, bind every value and keep the documented shape 1`] = `
{
  "journeys": "WITH v AS (SELECT s.day AS day, s.sid AS sid, (h.value ->> 'p') AS path, (s.started + CAST((h.value ->> 't') AS BIGINT)) AS ts, h.key AS id, LAG((h.value ->> 'p')) OVER (PARTITION BY s.day, s.sid ORDER BY (s.started + CAST((h.value ->> 't') AS BIGINT)), h.key) AS prior
FROM ca_sessions s CROSS JOIN jsonb_each(s.hits) AS h(key, value) WHERE ((s.site = ? AND s.day BETWEEN ? AND ?) AND (s.pageviews > 0)) AND ((CAST((h.value ->> 't') AS BIGINT) IS NOT NULL AND (h.value ->> 'n') IS NULL))),
p AS (SELECT v.day AS day, v.sid AS sid, v.path AS path, v.ts AS ts, v.id AS id FROM v WHERE v.prior IS NULL OR v.prior <> v.path),
seq AS (SELECT p.sid AS sid, p.path AS path, LAG(p.path) OVER (PARTITION BY p.day, p.sid ORDER BY p.ts, p.id) AS prev, LEAD(p.path) OVER (PARTITION BY p.day, p.sid ORDER BY p.ts, p.id) AS next, LEAD(p.path, 2) OVER (PARTITION BY p.day, p.sid ORDER BY p.ts, p.id) AS next2, ROW_NUMBER() OVER (PARTITION BY p.day, p.sid ORDER BY p.ts, p.id) AS n FROM p)
SELECT 'next' AS dim, t.path AS key, COALESCE(t.next, '(exit)') AS segkey, COUNT(DISTINCT t.sid) AS sessions FROM seq t WHERE COALESCE(t.next, '') <> t.path GROUP BY t.path, COALESCE(t.next, '(exit)')
UNION ALL SELECT 'next', '(entry)', t.path, COUNT(DISTINCT t.sid) FROM seq t WHERE t.n = 1 GROUP BY t.path
UNION ALL SELECT 'next', t.path, '', COUNT(DISTINCT t.sid) FROM seq t GROUP BY t.path
UNION ALL SELECT 'path3', t.path, COALESCE(t.next, '(exit)') || '' || CASE WHEN t.next IS NULL THEN '' ELSE COALESCE(t.next2, '(exit)') END, COUNT(*) FROM seq t WHERE t.n = 1 GROUP BY t.path, COALESCE(t.next, '(exit)'), CASE WHEN t.next IS NULL THEN '' ELSE COALESCE(t.next2, '(exit)') END",
  "links": "WITH e AS (SELECT COALESCE((h.value -> 'pr' ->> 'slug'), '(not set)') AS slug, COALESCE(NULLIF((h.value -> 'pr' ->> 'place'), ''), '(none)') AS place, CASE WHEN (h.value ->> 'n') = ? THEN 1 ELSE 0 END AS click, s.sid AS sid, r.val AS val, r.cur AS cur, CASE WHEN s.pageviews > 0 THEN 1 ELSE 0 END AS counted, CASE WHEN s.pageviews > 0 THEN COALESCE(s.channel, '(not set)') ELSE '(not set)' END AS channel, CASE WHEN s.pageviews > 0 THEN COALESCE(s.country, '(not set)') ELSE '(not set)' END AS country, CASE WHEN s.pageviews > 0 THEN COALESCE(s.device, '(not set)') ELSE '(not set)' END AS device FROM ca_sessions s CROSS JOIN jsonb_each(s.hits) AS h(key, value) LEFT JOIN ca_events r ON r.site = s.site AND r.id = h.key WHERE (s.site = ? AND s.day BETWEEN ? AND ?) AND ((h.value ->> 'n') IS NOT NULL) AND ((h.value ->> 'n') IN (?, ?)) UNION ALL SELECT COALESCE((h.props::jsonb ->> 'slug'), '(not set)') AS slug, COALESCE(NULLIF((h.props::jsonb ->> 'place'), ''), '(none)') AS place, CASE WHEN h.name = ? THEN 1 ELSE 0 END AS click, NULL AS sid, h.val AS val, h.cur AS cur, 0 AS counted, '(not set)' AS channel, '(not set)' AS country, '(not set)' AS device FROM ca_events h WHERE (h.site = ? AND h.day BETWEEN ? AND ? AND h.sid IS NULL AND (h.val IS NULL OR h.val >= 0)) AND (h.name IN (?, ?))), i AS (SELECT CASE WHEN strpos(p.value, '@') > 0 THEN substr(p.value, 1, strpos(p.value, '@') - 1) ELSE p.value END AS slug, CASE WHEN strpos(p.value, '@') > 0 THEN substr(p.value, strpos(p.value, '@') + 1) ELSE '(none)' END AS place, CASE WHEN s.pageviews > 0 THEN 1 ELSE 0 END AS counted, CASE WHEN s.pageviews > 0 THEN COALESCE(s.channel, '(not set)') ELSE '(not set)' END AS channel, CASE WHEN s.pageviews > 0 THEN COALESCE(s.country, '(not set)') ELSE '(not set)' END AS country, CASE WHEN s.pageviews > 0 THEN COALESCE(s.device, '(not set)') ELSE '(not set)' END AS device FROM ca_sessions s CROSS JOIN jsonb_each(s.hits) AS h(key, value), jsonb_each_text(h.value -> 'pr') AS p WHERE (s.site = ? AND s.day BETWEEN ? AND ?) AND ((h.value ->> 'n') IS NOT NULL) AND ((h.value ->> 'n') = ? AND p.key IN ('s0', 's1', 's2', 's3', 's4', 's5', 's6', 's7', 's8', 's9') AND p.value <> '') UNION ALL SELECT CASE WHEN strpos(p.value, '@') > 0 THEN substr(p.value, 1, strpos(p.value, '@') - 1) ELSE p.value END AS slug, CASE WHEN strpos(p.value, '@') > 0 THEN substr(p.value, strpos(p.value, '@') + 1) ELSE '(none)' END AS place, 0 AS counted, '(not set)' AS channel, '(not set)' AS country, '(not set)' AS device FROM ca_events h, jsonb_each_text(CAST(h.props AS jsonb)) AS p WHERE (h.site = ? AND h.day BETWEEN ? AND ? AND h.sid IS NULL AND (h.val IS NULL OR h.val >= 0)) AND (h.name = ? AND p.key IN ('s0', 's1', 's2', 's3', 's4', 's5', 's6', 's7', 's8', 's9') AND p.value <> '')) SELECT 'link' AS dim, '' AS seg, slug AS key, '' AS segkey, '' AS cur, 0 AS impressions, SUM(click) AS clicks, COUNT(DISTINCT CASE WHEN click = 1 AND counted = 1 THEN sid END) AS sessions, SUM(1 - click) AS conversions, 0 AS orders, 0 AS revenue FROM e WHERE 1 = 1 GROUP BY slug UNION ALL SELECT 'link' AS dim, '' AS seg, slug AS key, '' AS segkey, cur, 0, 0, 0, 0, COUNT(*), SUM(val) FROM e WHERE click = 0 AND val IS NOT NULL AND cur IS NOT NULL GROUP BY slug, cur UNION ALL SELECT 'link' AS dim, '' AS seg, slug AS key, '' AS segkey, '', COUNT(*), 0, 0, 0, 0, 0 FROM i WHERE 1 = 1 GROUP BY slug UNION ALL SELECT 'link_place' AS dim, '' AS seg, place AS key, '' AS segkey, '' AS cur, 0 AS impressions, SUM(click) AS clicks, COUNT(DISTINCT CASE WHEN click = 1 AND counted = 1 THEN sid END) AS sessions, SUM(1 - click) AS conversions, 0 AS orders, 0 AS revenue FROM e WHERE 1 = 1 GROUP BY place UNION ALL SELECT 'link_place' AS dim, '' AS seg, place AS key, '' AS segkey, cur, 0, 0, 0, 0, COUNT(*), SUM(val) FROM e WHERE click = 0 AND val IS NOT NULL AND cur IS NOT NULL GROUP BY place, cur UNION ALL SELECT 'link_place' AS dim, '' AS seg, place AS key, '' AS segkey, '', COUNT(*), 0, 0, 0, 0, 0 FROM i WHERE 1 = 1 GROUP BY place UNION ALL SELECT 'link' AS dim, 'channel' AS seg, slug AS key, channel AS segkey, '' AS cur, 0 AS impressions, SUM(click) AS clicks, COUNT(DISTINCT CASE WHEN click = 1 AND counted = 1 THEN sid END) AS sessions, SUM(1 - click) AS conversions, 0 AS orders, 0 AS revenue FROM e WHERE 1 = 1 AND counted = 1 GROUP BY slug, channel UNION ALL SELECT 'link' AS dim, 'channel' AS seg, slug AS key, channel AS segkey, cur, 0, 0, 0, 0, COUNT(*), SUM(val) FROM e WHERE click = 0 AND val IS NOT NULL AND cur IS NOT NULL AND counted = 1 GROUP BY slug, channel, cur UNION ALL SELECT 'link' AS dim, 'channel' AS seg, slug AS key, channel AS segkey, '', COUNT(*), 0, 0, 0, 0, 0 FROM i WHERE 1 = 1 AND counted = 1 GROUP BY slug, channel UNION ALL SELECT 'link' AS dim, 'country' AS seg, slug AS key, country AS segkey, '' AS cur, 0 AS impressions, SUM(click) AS clicks, COUNT(DISTINCT CASE WHEN click = 1 AND counted = 1 THEN sid END) AS sessions, SUM(1 - click) AS conversions, 0 AS orders, 0 AS revenue FROM e WHERE 1 = 1 AND counted = 1 GROUP BY slug, country UNION ALL SELECT 'link' AS dim, 'country' AS seg, slug AS key, country AS segkey, cur, 0, 0, 0, 0, COUNT(*), SUM(val) FROM e WHERE click = 0 AND val IS NOT NULL AND cur IS NOT NULL AND counted = 1 GROUP BY slug, country, cur UNION ALL SELECT 'link' AS dim, 'country' AS seg, slug AS key, country AS segkey, '', COUNT(*), 0, 0, 0, 0, 0 FROM i WHERE 1 = 1 AND counted = 1 GROUP BY slug, country UNION ALL SELECT 'link' AS dim, 'device' AS seg, slug AS key, device AS segkey, '' AS cur, 0 AS impressions, SUM(click) AS clicks, COUNT(DISTINCT CASE WHEN click = 1 AND counted = 1 THEN sid END) AS sessions, SUM(1 - click) AS conversions, 0 AS orders, 0 AS revenue FROM e WHERE 1 = 1 AND counted = 1 GROUP BY slug, device UNION ALL SELECT 'link' AS dim, 'device' AS seg, slug AS key, device AS segkey, cur, 0, 0, 0, 0, COUNT(*), SUM(val) FROM e WHERE click = 0 AND val IS NOT NULL AND cur IS NOT NULL AND counted = 1 GROUP BY slug, device, cur UNION ALL SELECT 'link' AS dim, 'device' AS seg, slug AS key, device AS segkey, '', COUNT(*), 0, 0, 0, 0, 0 FROM i WHERE 1 = 1 AND counted = 1 GROUP BY slug, device",
}
`;

exports[`link and journey day statements (sqlite) > are one statement each, bind every value and keep the documented shape 1`] = `
{
  "journeys": "WITH v AS (SELECT s.day AS day, s.sid AS sid, (h.value ->> 'p') AS path, (s.started + (h.value ->> 't')) AS ts, h.key AS id, LAG((h.value ->> 'p')) OVER (PARTITION BY s.day, s.sid ORDER BY (s.started + (h.value ->> 't')), h.key) AS prior
FROM ca_sessions s CROSS JOIN json_each(s.hits) AS h WHERE ((s.site = ? AND s.day BETWEEN ? AND ?) AND (s.pageviews > 0)) AND (((h.value ->> 't') IS NOT NULL AND (h.value ->> 'n') IS NULL))),
p AS (SELECT v.day AS day, v.sid AS sid, v.path AS path, v.ts AS ts, v.id AS id FROM v WHERE v.prior IS NULL OR v.prior <> v.path),
seq AS (SELECT p.sid AS sid, p.path AS path, LAG(p.path) OVER (PARTITION BY p.day, p.sid ORDER BY p.ts, p.id) AS prev, LEAD(p.path) OVER (PARTITION BY p.day, p.sid ORDER BY p.ts, p.id) AS next, LEAD(p.path, 2) OVER (PARTITION BY p.day, p.sid ORDER BY p.ts, p.id) AS next2, ROW_NUMBER() OVER (PARTITION BY p.day, p.sid ORDER BY p.ts, p.id) AS n FROM p)
SELECT 'next' AS dim, t.path AS key, COALESCE(t.next, '(exit)') AS segkey, COUNT(DISTINCT t.sid) AS sessions FROM seq t WHERE COALESCE(t.next, '') <> t.path GROUP BY t.path, COALESCE(t.next, '(exit)')
UNION ALL SELECT 'next', '(entry)', t.path, COUNT(DISTINCT t.sid) FROM seq t WHERE t.n = 1 GROUP BY t.path
UNION ALL SELECT 'next', t.path, '', COUNT(DISTINCT t.sid) FROM seq t GROUP BY t.path
UNION ALL SELECT 'path3', t.path, COALESCE(t.next, '(exit)') || '' || CASE WHEN t.next IS NULL THEN '' ELSE COALESCE(t.next2, '(exit)') END, COUNT(*) FROM seq t WHERE t.n = 1 GROUP BY t.path, COALESCE(t.next, '(exit)'), CASE WHEN t.next IS NULL THEN '' ELSE COALESCE(t.next2, '(exit)') END",
  "links": "WITH e AS (SELECT COALESCE(CAST(json_extract(h.value, '$.pr.slug') AS TEXT), '(not set)') AS slug, COALESCE(NULLIF(CAST(json_extract(h.value, '$.pr.place') AS TEXT), ''), '(none)') AS place, CASE WHEN (h.value ->> 'n') = ? THEN 1 ELSE 0 END AS click, s.sid AS sid, r.val AS val, r.cur AS cur, CASE WHEN s.pageviews > 0 THEN 1 ELSE 0 END AS counted, CASE WHEN s.pageviews > 0 THEN COALESCE(s.channel, '(not set)') ELSE '(not set)' END AS channel, CASE WHEN s.pageviews > 0 THEN COALESCE(s.country, '(not set)') ELSE '(not set)' END AS country, CASE WHEN s.pageviews > 0 THEN COALESCE(s.device, '(not set)') ELSE '(not set)' END AS device FROM ca_sessions s CROSS JOIN json_each(s.hits) AS h LEFT JOIN ca_events r ON r.site = s.site AND r.id = h.key WHERE (s.site = ? AND s.day BETWEEN ? AND ?) AND ((h.value ->> 'n') IS NOT NULL) AND ((h.value ->> 'n') IN (?, ?)) UNION ALL SELECT COALESCE(CAST(json_extract(h.props, '$.slug') AS TEXT), '(not set)') AS slug, COALESCE(NULLIF(CAST(json_extract(h.props, '$.place') AS TEXT), ''), '(none)') AS place, CASE WHEN h.name = ? THEN 1 ELSE 0 END AS click, NULL AS sid, h.val AS val, h.cur AS cur, 0 AS counted, '(not set)' AS channel, '(not set)' AS country, '(not set)' AS device FROM ca_events h WHERE (h.site = ? AND h.day BETWEEN ? AND ? AND h.sid IS NULL AND (h.val IS NULL OR h.val >= 0)) AND (h.name IN (?, ?))), i AS (SELECT CASE WHEN instr(CAST(p.value AS TEXT), '@') > 0 THEN substr(CAST(p.value AS TEXT), 1, instr(CAST(p.value AS TEXT), '@') - 1) ELSE CAST(p.value AS TEXT) END AS slug, CASE WHEN instr(CAST(p.value AS TEXT), '@') > 0 THEN substr(CAST(p.value AS TEXT), instr(CAST(p.value AS TEXT), '@') + 1) ELSE '(none)' END AS place, CASE WHEN s.pageviews > 0 THEN 1 ELSE 0 END AS counted, CASE WHEN s.pageviews > 0 THEN COALESCE(s.channel, '(not set)') ELSE '(not set)' END AS channel, CASE WHEN s.pageviews > 0 THEN COALESCE(s.country, '(not set)') ELSE '(not set)' END AS country, CASE WHEN s.pageviews > 0 THEN COALESCE(s.device, '(not set)') ELSE '(not set)' END AS device FROM ca_sessions s CROSS JOIN json_each(s.hits) AS h, json_each(h.value, '$.pr') AS p WHERE (s.site = ? AND s.day BETWEEN ? AND ?) AND ((h.value ->> 'n') IS NOT NULL) AND ((h.value ->> 'n') = ? AND p.key IN ('s0', 's1', 's2', 's3', 's4', 's5', 's6', 's7', 's8', 's9') AND CAST(p.value AS TEXT) <> '') UNION ALL SELECT CASE WHEN instr(CAST(p.value AS TEXT), '@') > 0 THEN substr(CAST(p.value AS TEXT), 1, instr(CAST(p.value AS TEXT), '@') - 1) ELSE CAST(p.value AS TEXT) END AS slug, CASE WHEN instr(CAST(p.value AS TEXT), '@') > 0 THEN substr(CAST(p.value AS TEXT), instr(CAST(p.value AS TEXT), '@') + 1) ELSE '(none)' END AS place, 0 AS counted, '(not set)' AS channel, '(not set)' AS country, '(not set)' AS device FROM ca_events h, json_each(h.props) AS p WHERE (h.site = ? AND h.day BETWEEN ? AND ? AND h.sid IS NULL AND (h.val IS NULL OR h.val >= 0)) AND (h.name = ? AND p.key IN ('s0', 's1', 's2', 's3', 's4', 's5', 's6', 's7', 's8', 's9') AND CAST(p.value AS TEXT) <> '')) SELECT 'link' AS dim, '' AS seg, slug AS key, '' AS segkey, '' AS cur, 0 AS impressions, SUM(click) AS clicks, COUNT(DISTINCT CASE WHEN click = 1 AND counted = 1 THEN sid END) AS sessions, SUM(1 - click) AS conversions, 0 AS orders, 0 AS revenue FROM e WHERE 1 = 1 GROUP BY slug UNION ALL SELECT 'link' AS dim, '' AS seg, slug AS key, '' AS segkey, cur, 0, 0, 0, 0, COUNT(*), SUM(val) FROM e WHERE click = 0 AND val IS NOT NULL AND cur IS NOT NULL GROUP BY slug, cur UNION ALL SELECT 'link' AS dim, '' AS seg, slug AS key, '' AS segkey, '', COUNT(*), 0, 0, 0, 0, 0 FROM i WHERE 1 = 1 GROUP BY slug UNION ALL SELECT 'link_place' AS dim, '' AS seg, place AS key, '' AS segkey, '' AS cur, 0 AS impressions, SUM(click) AS clicks, COUNT(DISTINCT CASE WHEN click = 1 AND counted = 1 THEN sid END) AS sessions, SUM(1 - click) AS conversions, 0 AS orders, 0 AS revenue FROM e WHERE 1 = 1 GROUP BY place UNION ALL SELECT 'link_place' AS dim, '' AS seg, place AS key, '' AS segkey, cur, 0, 0, 0, 0, COUNT(*), SUM(val) FROM e WHERE click = 0 AND val IS NOT NULL AND cur IS NOT NULL GROUP BY place, cur UNION ALL SELECT 'link_place' AS dim, '' AS seg, place AS key, '' AS segkey, '', COUNT(*), 0, 0, 0, 0, 0 FROM i WHERE 1 = 1 GROUP BY place UNION ALL SELECT 'link' AS dim, 'channel' AS seg, slug AS key, channel AS segkey, '' AS cur, 0 AS impressions, SUM(click) AS clicks, COUNT(DISTINCT CASE WHEN click = 1 AND counted = 1 THEN sid END) AS sessions, SUM(1 - click) AS conversions, 0 AS orders, 0 AS revenue FROM e WHERE 1 = 1 AND counted = 1 GROUP BY slug, channel UNION ALL SELECT 'link' AS dim, 'channel' AS seg, slug AS key, channel AS segkey, cur, 0, 0, 0, 0, COUNT(*), SUM(val) FROM e WHERE click = 0 AND val IS NOT NULL AND cur IS NOT NULL AND counted = 1 GROUP BY slug, channel, cur UNION ALL SELECT 'link' AS dim, 'channel' AS seg, slug AS key, channel AS segkey, '', COUNT(*), 0, 0, 0, 0, 0 FROM i WHERE 1 = 1 AND counted = 1 GROUP BY slug, channel UNION ALL SELECT 'link' AS dim, 'country' AS seg, slug AS key, country AS segkey, '' AS cur, 0 AS impressions, SUM(click) AS clicks, COUNT(DISTINCT CASE WHEN click = 1 AND counted = 1 THEN sid END) AS sessions, SUM(1 - click) AS conversions, 0 AS orders, 0 AS revenue FROM e WHERE 1 = 1 AND counted = 1 GROUP BY slug, country UNION ALL SELECT 'link' AS dim, 'country' AS seg, slug AS key, country AS segkey, cur, 0, 0, 0, 0, COUNT(*), SUM(val) FROM e WHERE click = 0 AND val IS NOT NULL AND cur IS NOT NULL AND counted = 1 GROUP BY slug, country, cur UNION ALL SELECT 'link' AS dim, 'country' AS seg, slug AS key, country AS segkey, '', COUNT(*), 0, 0, 0, 0, 0 FROM i WHERE 1 = 1 AND counted = 1 GROUP BY slug, country UNION ALL SELECT 'link' AS dim, 'device' AS seg, slug AS key, device AS segkey, '' AS cur, 0 AS impressions, SUM(click) AS clicks, COUNT(DISTINCT CASE WHEN click = 1 AND counted = 1 THEN sid END) AS sessions, SUM(1 - click) AS conversions, 0 AS orders, 0 AS revenue FROM e WHERE 1 = 1 AND counted = 1 GROUP BY slug, device UNION ALL SELECT 'link' AS dim, 'device' AS seg, slug AS key, device AS segkey, cur, 0, 0, 0, 0, COUNT(*), SUM(val) FROM e WHERE click = 0 AND val IS NOT NULL AND cur IS NOT NULL AND counted = 1 GROUP BY slug, device, cur UNION ALL SELECT 'link' AS dim, 'device' AS seg, slug AS key, device AS segkey, '', COUNT(*), 0, 0, 0, 0, 0 FROM i WHERE 1 = 1 AND counted = 1 GROUP BY slug, device",
}
`;
