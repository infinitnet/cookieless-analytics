    "params": [
      "a.org",
      "/blog/%",
    ],
    "sql": "(s.host = ?) AND (EXISTS (SELECT 1 FROM json_each(s.hits) AS x WHERE (((x.value ->> 't') IS NOT NULL AND (x.value ->> 'n') IS NULL)) AND (lower((x.value ->> 'p')) LIKE lower(?) ESCAPE '\\')))",
  },
  "srv": {
    "params": [
      "/blog/%",
    ],
    "sql": "(lower(h.path) LIKE lower(?) ESCAPE '\\')",
  },
}
