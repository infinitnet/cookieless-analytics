exports[`revenue filter snapshots (postgres) > currency and revenue compile to semi-joins with sid IS NOT NULL and no inlined value 1`] = `
{
  "currency is EUR": {
    "ev": {
      "params": [],
      "sql": "1 = 1",
    },
    "ignoredTraffic": [],
    "pv": {
      "params": [],
      "sql": "1 = 1",
    },
    "session": {
      "params": [
        "default",
        20260310,
        20260312,
        "EUR",
      ],
      "sql": "((s.day, s.sid) IN (SELECT x.sday, x.sid FROM ca_events x WHERE x.site = ? AND x.day BETWEEN ? AND ? AND x.val >= 0 AND x.sid IS NOT NULL AND x.sday IS NOT NULL AND x.cur = ?))",
    },
    "srv": {
      "params": [],
      "sql": "1 = 1",
    },
  },
  "currency is_not EUR,USD": {
    "ev": {
      "params": [],
      "sql": "1 = 1",
    },
    "ignoredTraffic": [],
    "pv": {
      "params": [],
      "sql": "1 = 1",
    },
    "session": {
      "params": [
        "default",
        20260310,
        20260312,
        "["EUR","USD"]",
      ],
      "sql": "((s.day, s.sid) NOT IN (SELECT x.sday, x.sid FROM ca_events x WHERE x.site = ? AND x.day BETWEEN ? AND ? AND x.val >= 0 AND x.sid IS NOT NULL AND x.sday IS NOT NULL AND x.cur IN (SELECT jsonb_array_elements_text(CAST(? AS jsonb)))))",
    },
    "srv": {
      "params": [],
      "sql": "1 = 1",
    },
  },
  "revenue gt 50": {
    "ev": {
      "params": [],
      "sql": "1 = 1",
    },
    "ignoredTraffic": [],
    "pv": {
      "params": [],
      "sql": "1 = 1",
    },
    "session": {
      "params": [
        "default",
        20260310,
        20260312,
        "EUR",
        50,
      ],
      "sql": "((s.day, s.sid) IN (SELECT x.sday, x.sid FROM ca_events x WHERE x.site = ? AND x.day BETWEEN ? AND ? AND x.val >= 0 AND x.sid IS NOT NULL AND x.sday IS NOT NULL AND x.cur = ? GROUP BY x.sday, x.sid HAVING SUM(x.val) > ?))",
    },
    "srv": {
      "params": [],
      "sql": "1 = 1",
    },
  },
  "revenue gte 50": {
    "ev": {
      "params": [],
      "sql": "1 = 1",
    },
    "ignoredTraffic": [],
    "pv": {
      "params": [],
      "sql": "1 = 1",
    },
    "session": {
      "params": [
        "default",
        20260310,
        20260312,
        "USD",
        50,
      ],
      "sql": "((s.day, s.sid) IN (SELECT x.sday, x.sid FROM ca_events x WHERE x.site = ? AND x.day BETWEEN ? AND ? AND x.val >= 0 AND x.sid IS NOT NULL AND x.sday IS NOT NULL AND x.cur = ? GROUP BY x.sday, x.sid HAVING SUM(x.val) >= ?))",
    },
    "srv": {
      "params": [],
      "sql": "1 = 1",
