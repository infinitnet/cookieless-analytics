// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`sequential funnels > keeps its rows and SQL byte identical to the stored snapshot 1`] = `"{"rows":[{"key":"1","label":"page is /","sessions":36,"drop_off":null,"conversion":1},{"key":"2","label":"page is /pricing","sessions":18,"drop_off":0.5,"conversion":0.5},{"key":"3","label":"event is signup","sessions":9,"drop_off":0.5,"conversion":0.25}],"name":"Signup flow","total":37,"adhoc":[{"key":"1","label":"page regex ^/$","sessions":36,"drop_off":null,"conversion":1},{"key":"2","label":"page prefix /pri","sessions":18,"drop_off":0.5,"conversion":0.5}],"sql":["SELECT SUM(t.sessions) AS sessions, SUM(t.events) AS events, SUM(t.pageviews) AS pageviews, SUM(t.visitors) AS visitors, SUM(t.bounces) AS bounces, SUM(t.engaged) AS engaged, SUM(t.duration_ms) AS duration_ms FROM (SELECT s.day AS day, COUNT(*) AS sessions, SUM(s.pageviews) AS pageviews, COUNT(DISTINCT s.vkey) AS visitors, SUM(s.events) AS events,\\nSUM(CASE WHEN s.pageviews = 1 AND s.events = 0 THEN 1 ELSE 0 END) AS bounces,\\nSUM(CASE WHEN s.engaged_ms >= ? OR s.pageviews > 1 OR s.events > 0 THEN 1 ELSE 0 END) AS engaged,\\nSUM(CASE WHEN (s.last_seen - s.started) * 1000 > s.visible_ms THEN (s.last_seen - s.started) * 1000 ELSE s.visible_ms END) AS duration_ms\\nFROM ca_sessions s WHERE ((s.site = ? AND s.day BETWEEN ? AND ?) AND (s.pageviews > 0)) GROUP BY s.day) t","SELECT s.day || '|' || s.sid AS sid, (s.started + (h.value ->> 't')) AS ts, CASE WHEN (((h.value ->> 't') IS NOT NULL AND (h.value ->> 'n') IS NULL)) AND ((h.value ->> 'p') = ?) THEN 1 ELSE 0 END AS m0, CASE WHEN (((h.value ->> 't') IS NOT NULL AND (h.value ->> 'n') IS NULL)) AND ((h.value ->> 'p') = ?) THEN 1 ELSE 0 END AS m1, CASE WHEN ((h.value ->> 'n') IS NOT NULL AND (h.value ->> 'n') = ?) THEN 1 ELSE 0 END AS m2 FROM ca_sessions s CROSS JOIN json_each(s.hits) AS h WHERE ((s.site = ? AND s.day BETWEEN ? AND ?) AND (s.pageviews > 0)) AND (((((h.value ->> 't') IS NOT NULL AND (h.value ->> 'n') IS NULL)) AND ((h.value ->> 'p') = ?)) OR ((((h.value ->> 't') IS NOT NULL AND (h.value ->> 'n') IS NULL)) AND ((h.value ->> 'p') = ?)) OR (((h.value ->> 'n') IS NOT NULL AND (h.value ->> 'n') = ?))) ORDER BY s.day, s.sid, ts, h.key","SELECT SUM(t.sessions) AS sessions, SUM(t.events) AS events, SUM(t.pageviews) AS pageviews, SUM(t.visitors) AS visitors, SUM(t.bounces) AS bounces, SUM(t.engaged) AS engaged, SUM(t.duration_ms) AS duration_ms FROM (SELECT s.day AS day, COUNT(*) AS sessions, SUM(s.pageviews) AS pageviews, COUNT(DISTINCT s.vkey) AS visitors, SUM(s.events) AS events,\\nSUM(CASE WHEN s.pageviews = 1 AND s.events = 0 THEN 1 ELSE 0 END) AS bounces,\\nSUM(CASE WHEN s.engaged_ms >= ? OR s.pageviews > 1 OR s.events > 0 THEN 1 ELSE 0 END) AS engaged,\\nSUM(CASE WHEN (s.last_seen - s.started) * 1000 > s.visible_ms THEN (s.last_seen - s.started) * 1000 ELSE s.visible_ms END) AS duration_ms\\nFROM ca_sessions s WHERE ((s.site = ? AND s.day BETWEEN ? AND ?) AND (s.pageviews > 0)) GROUP BY s.day) t","SELECT DISTINCT t.v AS v FROM (SELECT (x.value ->> 'p') AS v FROM ca_sessions s CROSS JOIN json_each(s.hits) AS x WHERE s.site = ? AND s.day BETWEEN ? AND ? AND ((x.value ->> 't') IS NOT NULL AND (x.value ->> 'n') IS NULL)) t WHERE t.v IS NOT NULL LIMIT 5001","SELECT s.day || '|' || s.sid AS sid, (s.started + (h.value ->> 't')) AS ts, CASE WHEN (((h.value ->> 't') IS NOT NULL AND (h.value ->> 'n') IS NULL)) AND ((h.value ->> 'p') = ?) THEN 1 ELSE 0 END AS m0, CASE WHEN (((h.value ->> 't') IS NOT NULL AND (h.value ->> 'n') IS NULL)) AND (lower((h.value ->> 'p')) LIKE lower(?) ESCAPE '\\\\') THEN 1 ELSE 0 END AS m1 FROM ca_sessions s CROSS JOIN json_each(s.hits) AS h WHERE ((s.site = ? AND s.day BETWEEN ? AND ?) AND (s.pageviews > 0)) AND (((((h.value ->> 't') IS NOT NULL AND (h.value ->> 'n') IS NULL)) AND ((h.value ->> 'p') = ?)) OR ((((h.value ->> 't') IS NOT NULL AND (h.value ->> 'n') IS NULL)) AND (lower((h.value ->> 'p')) LIKE lower(?) ESCAPE '\\\\'))) ORDER BY s.day, s.sid, ts, h.key"]}"`;
