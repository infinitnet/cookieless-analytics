// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Postgres statements (strings only) > keeps its statement text 1`] = `
{
  "alias": "INSERT INTO ca_aliases (site, sid, canon, expires) VALUES (CAST(? AS TEXT), CAST(? AS TEXT), CAST(? AS TEXT), CAST(? AS BIGINT)) ON CONFLICT (site, sid) DO UPDATE SET canon = excluded.canon, expires = excluded.expires WHERE ca_aliases.canon <> excluded.canon OR ca_aliases.expires < excluded.expires - CAST(? AS BIGINT)",
  "insert": "INSERT INTO ca_sessions (site, sid, vkey, day, hour, started, last_seen, window_s, entry_path, exit_path, pageviews, events, engaged_ms, max_scroll, interacted, ref_host, ref_path, channel, source, utm_source, utm_medium, utm_campaign, utm_term, utm_content, country, region, device, browser, browser_major, os, lang, screen, host, hits) VALUES (CAST(? AS TEXT), CAST(? AS TEXT), CAST(? AS TEXT), CAST(? AS TEXT), CAST(? AS BIGINT), CAST(? AS BIGINT), CAST(? AS BIGINT), CAST(? AS BIGINT), CAST(? AS TEXT), CAST(? AS TEXT), CAST(? AS BIGINT), CAST(? AS BIGINT), CAST(? AS BIGINT), CAST(? AS BIGINT), CAST(? AS BIGINT), CAST(? AS TEXT), CAST(? AS TEXT), CAST(? AS TEXT), CAST(? AS TEXT), CAST(? AS TEXT), CAST(? AS TEXT), CAST(? AS TEXT), CAST(? AS TEXT), CAST(? AS TEXT), CAST(? AS TEXT), CAST(? AS TEXT), CAST(? AS TEXT), CAST(? AS TEXT), CAST(? AS TEXT), CAST(? AS TEXT), CAST(? AS TEXT), CAST(? AS TEXT), CAST(? AS TEXT), jsonb_build_object(CAST(? AS TEXT), jsonb_build_object('t', CAST(? AS BIGINT), 'p', CAST(? AS TEXT), 'qs', CAST(? AS TEXT), 'nt', CAST(? AS BIGINT)))) ON CONFLICT DO NOTHING RETURNING sid",
  "order": "INSERT INTO ca_events (site, id, day, ts, sday, sid, name, path, props, val, cur) SELECT CAST(? AS TEXT), CAST(? AS TEXT), CAST(? AS BIGINT), CAST(? AS BIGINT), v.day, v.sid, CAST(? AS TEXT), COALESCE(CAST(? AS TEXT), v.exit_path), CAST(? AS TEXT), CAST(? AS DOUBLE PRECISION), CAST(? AS TEXT) FROM (SELECT 1 AS one) o LEFT JOIN ca_sessions v ON v.site = CAST(? AS TEXT) AND v.day IN (CAST(? AS TEXT), CAST(? AS TEXT)) AND v.sid = COALESCE((SELECT canon FROM ca_aliases WHERE site = CAST(? AS TEXT) AND sid = CAST(? AS TEXT) AND expires >= CAST(? AS BIGINT)), CAST(? AS TEXT)) WHERE 1 = 1 ON CONFLICT (site, id) DO NOTHING RETURNING sid",
  "read": "SELECT a.canon AS canon, v.site, v.sid, v.vkey, v.day, v.hour, v.started, v.last_seen, v.window_s, v.entry_path, v.exit_path, v.pageviews, v.events, v.engaged_ms, v.max_scroll, v.interacted, v.ref_host, v.ref_path, v.channel, v.source, v.utm_source, v.utm_medium, v.utm_campaign, v.utm_term, v.utm_content, v.country, v.region, v.device, v.browser, v.browser_major, v.os, v.lang, v.screen, v.host, (v.hits -> CAST(? AS TEXT) ->> 't') IS NOT NULL AS seen FROM (SELECT (SELECT canon FROM ca_aliases WHERE site = CAST(? AS TEXT) AND sid = CAST(? AS TEXT) AND expires >= CAST(? AS BIGINT)) AS canon) a LEFT JOIN ca_sessions v ON v.site = CAST(? AS TEXT) AND v.day IN (CAST(? AS TEXT), CAST(? AS TEXT)) AND (v.sid = CAST(? AS TEXT) OR v.sid = a.canon OR (v.vkey IN (CAST(? AS TEXT), CAST(? AS TEXT)) AND v.last_seen + v.window_s >= CAST(? AS BIGINT)))",
  "s1": "UPDATE ca_sessions SET hits = (hits || jsonb_build_object(CAST(? AS TEXT), COALESCE(hits -> CAST(? AS TEXT), '{}'::jsonb) || jsonb_build_object('t', CAST(? AS BIGINT) - started, 'p', CAST(? AS TEXT), 'qs', CAST(? AS TEXT), 'nt', CAST(? AS BIGINT), 're', CAST(? AS BIGINT)))), pageviews = pageviews + 1, last_seen = GREATEST(last_seen, CAST(? AS BIGINT)), exit_path = CAST(? AS TEXT), reentries = reentries + 1 WHERE site = CAST(? AS TEXT) AND day = CAST(? AS TEXT) AND sid = CAST(? AS TEXT) AND (hits -> CAST(? AS TEXT) ->> 't') IS NULL AND CAST(? AS BIGINT) - last_seen <= window_s AND CAST(? AS BIGINT) - started <= CAST(? AS BIGINT) AND pageviews < CAST(? AS BIGINT) RETURNING sid",
  "s2": "UPDATE ca_sessions SET engaged_ms = engaged_ms + GREATEST(0, CAST(? AS BIGINT) - COALESCE(CAST((hits -> CAST(? AS TEXT) ->> 'd') AS BIGINT), 0)), visible_ms = visible_ms + GREATEST(0, CAST(? AS BIGINT) - COALESCE(CAST((hits -> CAST(? AS TEXT) ->> 'e') AS BIGINT), 0)), max_scroll = GREATEST(max_scroll, CAST(? AS BIGINT)), interacted = GREATEST(interacted, CAST(? AS BIGINT)), hits = (hits || jsonb_build_object(CAST(? AS TEXT), COALESCE(hits -> CAST(? AS TEXT), '{}'::jsonb) || jsonb_build_object('d', GREATEST(CAST(? AS BIGINT), COALESCE(CAST((hits -> CAST(? AS TEXT) ->> 'd') AS BIGINT), 0)), 'e', GREATEST(CAST(? AS BIGINT), COALESCE(CAST((hits -> CAST(? AS TEXT) ->> 'e') AS BIGINT), 0)), 's', GREATEST(CAST(? AS BIGINT), COALESCE(CAST((hits -> CAST(? AS TEXT) ->> 's') AS BIGINT), 0)), 'x', GREATEST(CAST(? AS BIGINT), COALESCE(CAST((hits -> CAST(? AS TEXT) ->> 'x') AS BIGINT), 0))))) WHERE site = CAST(? AS TEXT) AND day IN (CAST(? AS TEXT), CAST(? AS TEXT)) AND sid = COALESCE((SELECT canon FROM ca_aliases WHERE site = CAST(? AS TEXT) AND sid = CAST(? AS TEXT) AND expires >= CAST(? AS BIGINT)), CAST(? AS TEXT)) AND ((hits -> CAST(? AS TEXT) ->> 't') IS NOT NULL OR (hits -> CAST(? AS TEXT) ->> 'd') IS NOT NULL OR (started >= CAST(? AS BIGINT) AND pageviews < CAST(? AS BIGINT) AND pg_column_size(hits) < CAST(? AS BIGINT)))",
  "s3": "UPDATE ca_sessions SET hits = (hits || jsonb_build_object(CAST(? AS TEXT), COALESCE(hits -> CAST(? AS TEXT), '{}'::jsonb) || jsonb_build_object('t', CAST(? AS BIGINT) - started, 'n', CAST(? AS TEXT), 'p', exit_path, 'pr', CAST(? AS JSONB)))), events = events + 1, last_seen = CASE WHEN CAST(? AS BIGINT) - last_seen <= window_s THEN GREATEST(last_seen, CAST(? AS BIGINT)) ELSE last_seen END WHERE sid = 'x' AND (hits -> CAST(? AS TEXT) ->> 't') IS NULL AND CAST(? AS BIGINT) - started <= CAST(? AS BIGINT) AND events < CAST(? AS BIGINT) RETURNING sid",
  "srv": "INSERT INTO ca_srv (site, day, status, path, ref, n, last_ts) VALUES (CAST(? AS TEXT), CAST(? AS BIGINT), CAST(? AS BIGINT), CAST(? AS TEXT), CAST(? AS TEXT), CAST(? AS BIGINT), CAST(? AS BIGINT)) ON CONFLICT (site, day, status, path, ref) DO UPDATE SET last_ts = excluded.last_ts, n = ca_srv.n + excluded.n",
}
`;
