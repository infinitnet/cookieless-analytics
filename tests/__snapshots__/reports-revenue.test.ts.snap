exports[`revenue statement snapshots (postgres) > every raw and rollup revenue statement binds its values and joins each order to its visit by the visit key 1`] = `
{
  "channels withRevenue": [
    {
      "params": [
        10000,
        "default",
        "2026-02-01",
        "2026-03-12",
        101,
        0,
      ],
      "sql": "SELECT t.key AS key, SUM(t.sessions) AS sessions, SUM(t.events) AS events, SUM(t.pageviews) AS pageviews, SUM(t.visitors) AS visitors, SUM(t.sessions) - SUM(t.engaged) AS bounces, SUM(t.engaged) AS engaged, SUM(t.duration_ms) AS duration_ms FROM (SELECT COALESCE(s.channel, '(not set)') AS key, s.day AS day, COUNT(*) AS sessions, SUM(s.pageviews) AS pageviews, COUNT(DISTINCT s.vkey) AS visitors, SUM(s.events) AS events,
SUM(CASE WHEN s.engaged_ms >= ? OR s.pageviews > 1 OR s.events > 0 THEN 1 ELSE 0 END) AS engaged,
SUM(CASE WHEN (s.last_seen - s.started) * 1000 > s.visible_ms THEN (s.last_seen - s.started) * 1000 ELSE s.visible_ms END) AS duration_ms
FROM ca_sessions s WHERE ((s.site = ? AND s.day BETWEEN ? AND ?) AND (s.pageviews > 0)) GROUP BY COALESCE(s.channel, '(not set)'), s.day) t GROUP BY t.key ORDER BY sessions DESC, key LIMIT ? OFFSET ?",
    },
    {
      "params": [
        "default",
        20260201,
        20260312,
      ],
      "sql": "SELECT h.cur AS cur, SUM(CASE WHEN h.val >= 0 THEN 1 ELSE 0 END) AS orders, SUM(CASE WHEN h.val >= 0 THEN h.val ELSE 0 END) AS revenue, SUM(CASE WHEN h.val < 0 THEN -h.val ELSE 0 END) AS refunds, COUNT(DISTINCT CASE WHEN h.val >= 0 THEN h.sday || '|' || h.sid END) AS sessions FROM ca_events h LEFT JOIN ca_sessions s ON s.site = h.site AND s.day = h.sday AND s.sid = h.sid WHERE (h.site = ? AND h.day BETWEEN ? AND ? AND h.val IS NOT NULL) GROUP BY h.cur",
    },
    {
      "params": [
        "default",
        20260201,
        20260312,
        "USD",
      ],
      "sql": "SELECT CASE WHEN s.pageviews > 0 THEN COALESCE(s.channel, '(not set)') ELSE '(not set)' END AS key, SUM(CASE WHEN h.val >= 0 THEN 1 ELSE 0 END) AS orders, SUM(CASE WHEN h.val >= 0 THEN h.val ELSE 0 END) AS revenue, SUM(CASE WHEN h.val < 0 THEN -h.val ELSE 0 END) AS refunds, COUNT(DISTINCT CASE WHEN h.val >= 0 THEN h.sday || '|' || h.sid END) AS sessions FROM ca_events h LEFT JOIN ca_sessions s ON s.site = h.site AND s.day = h.sday AND s.sid = h.sid WHERE (h.site = ? AND h.day BETWEEN ? AND ? AND h.val IS NOT NULL) AND (h.cur = ?) GROUP BY CASE WHEN s.pageviews > 0 THEN COALESCE(s.channel, '(not set)') ELSE '(not set)' END",
    },
  ],
  "computeRevenueDays": [
    {
      "params": [
