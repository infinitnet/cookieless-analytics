      "sql": "SELECT 'goal' AS dim, CAST(? AS TEXT) AS key, h.day AS day, h.cur AS cur, CASE WHEN s.pageviews > 0 THEN COALESCE(s.channel, '(not set)') ELSE '(not set)' END AS channel, CASE WHEN s.pageviews > 0 THEN COALESCE(s.country, '(not set)') ELSE '(not set)' END AS country, CASE WHEN s.pageviews > 0 THEN COALESCE(s.device, '(not set)') ELSE '(not set)' END AS device, SUM(CASE WHEN h.val >= 0 THEN 1 ELSE 0 END) AS orders, SUM(CASE WHEN h.val >= 0 THEN h.val ELSE 0 END) AS revenue, SUM(CASE WHEN h.val < 0 THEN -h.val ELSE 0 END) AS refunds, COUNT(DISTINCT CASE WHEN h.val >= 0 THEN h.sday || '|' || h.sid END) AS sessions FROM ca_events h LEFT JOIN ca_sessions s ON s.site = h.site AND s.day = h.sday AND s.sid = h.sid WHERE (h.site = ? AND h.val IS NOT NULL) AND (h.day IN (SELECT CAST(jsonb_array_elements_text(CAST(? AS jsonb)) AS BIGINT))) AND ((1 = 1 AND h.name = ?)) GROUP BY h.day, h.cur, CASE WHEN s.pageviews > 0 THEN COALESCE(s.channel, '(not set)') ELSE '(not set)' END, CASE WHEN s.pageviews > 0 THEN COALESCE(s.country, '(not set)') ELSE '(not set)' END, CASE WHEN s.pageviews > 0 THEN COALESCE(s.device, '(not set)') ELSE '(not set)' END UNION ALL SELECT 'goal' AS dim, CAST(? AS TEXT) AS key, h.day AS day, h.cur AS cur, CASE WHEN s.pageviews > 0 THEN COALESCE(s.channel, '(not set)') ELSE '(not set)' END AS channel, CASE WHEN s.pageviews > 0 THEN COALESCE(s.country, '(not set)') ELSE '(not set)' END AS country, CASE WHEN s.pageviews > 0 THEN COALESCE(s.device, '(not set)') ELSE '(not set)' END AS device, SUM(CASE WHEN h.val >= 0 THEN 1 ELSE 0 END) AS orders, SUM(CASE WHEN h.val >= 0 THEN h.val ELSE 0 END) AS revenue, SUM(CASE WHEN h.val < 0 THEN -h.val ELSE 0 END) AS refunds, COUNT(DISTINCT CASE WHEN h.val >= 0 THEN h.sday || '|' || h.sid END) AS sessions FROM ca_events h LEFT JOIN ca_sessions s ON s.site = h.site AND s.day = h.sday AND s.sid = h.sid WHERE (h.site = ? AND h.val IS NOT NULL) AND (h.day IN (SELECT CAST(jsonb_array_elements_text(CAST(? AS jsonb)) AS BIGINT))) AND ((1 = 1 AND h.name = ?) AND ((h.props::jsonb ->> 'plan') = ?)) GROUP BY h.day, h.cur, CASE WHEN s.pageviews > 0 THEN COALESCE(s.channel, '(not set)') ELSE '(not set)' END, CASE WHEN s.pageviews > 0 THEN COALESCE(s.country, '(not set)') ELSE '(not set)' END, CASE WHEN s.pageviews > 0 THEN COALESCE(s.device, '(not set)') ELSE '(not set)' END",
