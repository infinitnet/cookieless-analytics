      "sql": "SELECT 'r' AS src, CAST(h.day AS TEXT) AS day, h.cur AS cur, SUM(CASE WHEN h.val >= 0 THEN 1 ELSE 0 END) AS orders, SUM(CASE WHEN h.val >= 0 THEN h.val ELSE 0 END) AS revenue, SUM(CASE WHEN h.val < 0 THEN -h.val ELSE 0 END) AS refunds, COUNT(DISTINCT CASE WHEN h.val >= 0 THEN h.sday || '|' || h.sid END) AS sessions, SUM(CASE WHEN h.val >= 0 AND (h.sid IS NULL OR s.sid IS NOT NULL) AND CASE WHEN s.pageviews > 0 THEN COALESCE(s.channel, '(not set)') ELSE '(not set)' END = '(not set)' THEN 1 ELSE 0 END) AS unset, SUM(CASE WHEN h.val >= 0 AND h.sid IS NOT NULL AND s.sid IS NULL THEN 1 ELSE 0 END) AS orphans FROM ca_events h LEFT JOIN ca_sessions s ON s.site = h.site AND s.day = h.sday AND s.sid = h.sid WHERE h.site = ? AND h.day BETWEEN ? AND ? AND h.val IS NOT NULL GROUP BY h.day, h.cur
