        "[20260310,20260311]",
        "default",
        "[20260310,20260311]",
        "default",
        "[20260310,20260311]",
        "default",
        "[20260310,20260311]",
      ],
      "sql": "SELECT 'all' AS dim, '' AS key, h.day AS day, h.cur AS cur, CASE WHEN s.pageviews > 0 THEN COALESCE(s.channel, '(not set)') ELSE '(not set)' END AS channel, CASE WHEN s.pageviews > 0 THEN COALESCE(s.country, '(not set)') ELSE '(not set)' END AS country, CASE WHEN s.pageviews > 0 THEN COALESCE(s.device, '(not set)') ELSE '(not set)' END AS device, SUM(CASE WHEN h.val >= 0 THEN 1 ELSE 0 END) AS orders, SUM(CASE WHEN h.val >= 0 THEN h.val ELSE 0 END) AS revenue, SUM(CASE WHEN h.val < 0 THEN -h.val ELSE 0 END) AS refunds, COUNT(DISTINCT CASE WHEN h.val >= 0 THEN h.sday || '|' || h.sid END) AS sessions FROM ca_events h LEFT JOIN ca_sessions s ON s.site = h.site AND s.day = h.sday AND s.sid = h.sid WHERE (h.site = ? AND h.val IS NOT NULL) AND (h.day IN (SELECT CAST(jsonb_array_elements_text(CAST(? AS jsonb)) AS BIGINT))) GROUP BY h.day, h.cur, CASE WHEN s.pageviews > 0 THEN COALESCE(s.channel, '(not set)') ELSE '(not set)' END, CASE WHEN s.pageviews > 0 THEN COALESCE(s.country, '(not set)') ELSE '(not set)' END, CASE WHEN s.pageviews > 0 THEN COALESCE(s.device, '(not set)') ELSE '(not set)' END UNION ALL SELECT 'channel' AS dim, CASE WHEN s.pageviews > 0 THEN COALESCE(s.channel, '(not set)') ELSE '(not set)' END AS key, h.day AS day, h.cur AS cur, CASE WHEN s.pageviews > 0 THEN COALESCE(s.channel, '(not set)') ELSE '(not set)' END AS channel, CASE WHEN s.pageviews > 0 THEN COALESCE(s.country, '(not set)') ELSE '(not set)' END AS country, CASE WHEN s.pageviews > 0 THEN COALESCE(s.device, '(not set)') ELSE '(not set)' END AS device, SUM(CASE WHEN h.val >= 0 THEN 1 ELSE 0 END) AS orders, SUM(CASE WHEN h.val >= 0 THEN h.val ELSE 0 END) AS revenue, SUM(CASE WHEN h.val < 0 THEN -h.val ELSE 0 END) AS refunds, COUNT(DISTINCT CASE WHEN h.val >= 0 THEN h.sday || '|' || h.sid END) AS sessions FROM ca_events h LEFT JOIN ca_sessions s ON s.site = h.site AND s.day = h.sday AND s.sid = h.sid WHERE (h.site = ? AND h.val IS NOT NULL) AND (h.day IN (SELECT CAST(jsonb_array_elements_text(CAST(? AS jsonb)) AS BIGINT))) GROUP BY CASE WHEN s.pageviews > 0 THEN COALESCE(s.channel, '(not set)') ELSE '(not set)' END, h.day, h.cur, CASE WHEN s.pageviews > 0 THEN COALESCE(s.channel, '(not set)') ELSE '(not set)' END, CASE WHEN s.pageviews > 0 THEN COALESCE(s.country, '(not set)') ELSE '(not set)' END, CASE WHEN s.pageviews > 0 THEN COALESCE(s.device, '(not set)') ELSE '(not set)' END UNION ALL SELECT 'source' AS dim, CASE WHEN s.pageviews > 0 THEN COALESCE(s.source, '(not set)') ELSE '(not set)' END AS key, h.day AS day, h.cur AS cur, CASE WHEN s.pageviews > 0 THEN COALESCE(s.channel, '(not set)') ELSE '(not set)' END AS channel, CASE WHEN s.pageviews > 0 THEN COALESCE(s.country, '(not set)') ELSE '(not set)' END AS country, CASE WHEN s.pageviews > 0 THEN COALESCE(s.device, '(not set)') ELSE '(not set)' END AS device, SUM(CASE WHEN h.val >= 0 THEN 1 ELSE 0 END) AS orders, SUM(CASE WHEN h.val >= 0 THEN h.val ELSE 0 END) AS revenue, SUM(CASE WHEN h.val < 0 THEN -h.val ELSE 0 END) AS refunds, COUNT(DISTINCT CASE WHEN h.val >= 0 THEN h.sday || '|' || h.sid END) AS sessions FROM ca_events h LEFT JOIN ca_sessions s ON s.site = h.site AND s.day = h.sday AND s.sid = h.sid WHERE (h.site = ? AND h.val IS NOT NULL) AND (h.day IN (SELECT CAST(jsonb_array_elements_text(CAST(? AS jsonb)) AS BIGINT))) GROUP BY CASE WHEN s.pageviews > 0 THEN COALESCE(s.source, '(not set)') ELSE '(not set)' END, h.day, h.cur, CASE WHEN s.pageviews > 0 THEN COALESCE(s.channel, '(not set)') ELSE '(not set)' END, CASE WHEN s.pageviews > 0 THEN COALESCE(s.country, '(not set)') ELSE '(not set)' END, CASE WHEN s.pageviews > 0 THEN COALESCE(s.device, '(not set)') ELSE '(not set)' END UNION ALL SELECT 'utm_campaign' AS dim, CASE WHEN s.pageviews > 0 THEN COALESCE(s.utm_campaign, '(not set)') ELSE '(not set)' END AS key, h.day AS day, h.cur AS cur, CASE WHEN s.pageviews > 0 THEN COALESCE(s.channel, '(not set)') ELSE '(not set)' END AS channel, CASE WHEN s.pageviews > 0 THEN COALESCE(s.country, '(not set)') ELSE '(not set)' END AS country, CASE WHEN s.pageviews > 0 THEN COALESCE(s.device, '(not set)') ELSE '(not set)' END AS device, SUM(CASE WHEN h.val >= 0 THEN 1 ELSE 0 END) AS orders, SUM(CASE WHEN h.val >= 0 THEN h.val ELSE 0 END) AS revenue, SUM(CASE WHEN h.val < 0 THEN -h.val ELSE 0 END) AS refunds, COUNT(DISTINCT CASE WHEN h.val >= 0 THEN h.sday || '|' || h.sid END) AS sessions FROM ca_events h LEFT JOIN ca_sessions s ON s.site = h.site AND s.day = h.sday AND s.sid = h.sid WHERE (h.site = ? AND h.val IS NOT NULL) AND (h.day IN (SELECT CAST(jsonb_array_elements_text(CAST(? AS jsonb)) AS BIGINT))) GROUP BY CASE WHEN s.pageviews > 0 THEN COALESCE(s.utm_campaign, '(not set)') ELSE '(not set)' END, h.day, h.cur, CASE WHEN s.pageviews > 0 THEN COALESCE(s.channel, '(not set)') ELSE '(not set)' END, CASE WHEN s.pageviews > 0 THEN COALESCE(s.country, '(not set)') ELSE '(not set)' END, CASE WHEN s.pageviews > 0 THEN COALESCE(s.device, '(not set)') ELSE '(not set)' END UNION ALL SELECT 'entry' AS dim, CASE WHEN s.pageviews > 0 THEN COALESCE(s.entry_path, '(not set)') ELSE '(not set)' END AS key, h.day AS day, h.cur AS cur, CASE WHEN s.pageviews > 0 THEN COALESCE(s.channel, '(not set)') ELSE '(not set)' END AS channel, CASE WHEN s.pageviews > 0 THEN COALESCE(s.country, '(not set)') ELSE '(not set)' END AS country, CASE WHEN s.pageviews > 0 THEN COALESCE(s.device, '(not set)') ELSE '(not set)' END AS device, SUM(CASE WHEN h.val >= 0 THEN 1 ELSE 0 END) AS orders, SUM(CASE WHEN h.val >= 0 THEN h.val ELSE 0 END) AS revenue, SUM(CASE WHEN h.val < 0 THEN -h.val ELSE 0 END) AS refunds, COUNT(DISTINCT CASE WHEN h.val >= 0 THEN h.sday || '|' || h.sid END) AS sessions FROM ca_events h LEFT JOIN ca_sessions s ON s.site = h.site AND s.day = h.sday AND s.sid = h.sid WHERE (h.site = ? AND h.val IS NOT NULL) AND (h.day IN (SELECT CAST(jsonb_array_elements_text(CAST(? AS jsonb)) AS BIGINT))) GROUP BY CASE WHEN s.pageviews > 0 THEN COALESCE(s.entry_path, '(not set)') ELSE '(not set)' END, h.day, h.cur, CASE WHEN s.pageviews > 0 THEN COALESCE(s.channel, '(not set)') ELSE '(not set)' END, CASE WHEN s.pageviews > 0 THEN COALESCE(s.country, '(not set)') ELSE '(not set)' END, CASE WHEN s.pageviews > 0 THEN COALESCE(s.device, '(not set)') ELSE '(not set)' END",
