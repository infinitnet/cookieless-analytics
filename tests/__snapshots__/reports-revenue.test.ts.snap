      "sql": "SELECT r.key AS key, r.segkey AS segkey, r.cur AS cur, SUM(r.orders) AS orders, SUM(CASE WHEN r.dim LIKE 'refund.%' THEN 0 ELSE r.revenue END) AS revenue, SUM(r.sessions) AS sessions, SUM(CASE WHEN r.dim LIKE 'refund.%' THEN r.revenue ELSE 0 END) AS refunds FROM ca_revenue_daily r WHERE r.site = ? AND r.dim IN (?, ?) AND r.seg = ? AND r.day BETWEEN ? AND ? GROUP BY r.key, r.segkey, r.cur",
