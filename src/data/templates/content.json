			"report": "overview",
			"kind": "kpi",
			"w": 1,
			"metric": "pageviews"
		},
		{
			"id": "ct0002",
			"report": "overview",
			"kind": "kpi",
			"w": 1,
			"metric": "views_per_session"
		},
		{
			"id": "ct0003",
			"report": "overview",
