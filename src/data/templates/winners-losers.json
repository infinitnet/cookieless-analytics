{
	"kind": "dashboard-template",
	"v": 1,
	"name": "Winners and losers",
	"description": "Rising and declining pages and queries, new and lost queries, and content decay.",
	"tiles": [
		{
			"id": "wl0001",
			"report": "search_movers",
			"kind": "table",
			"w": 1,
			"title": "Rising pages",
			"params": {
				"dim": "page",
				"direction": "up"
			}
		},
		{
			"id": "wl0002",
			"report": "search_movers",
			"kind": "table",
			"w": 2,
			"title": "Declining pages",
			"params": {
				"dim": "page",
				"direction": "down"
			}
		},
		{
			"id": "wl0003",
			"report": "search_movers",
			"kind": "table",
			"w": 1,
			"title": "Rising queries",
			"params": {
				"dim": "query",
				"direction": "up"
			}
		},
		{
			"id": "wl0004",
			"report": "search_movers",
			"kind": "table",
			"w": 2,
			"title": "Declining queries",
			"params": {
				"dim": "query",
				"direction": "down"
			}
		},
		{
			"id": "wl0005",
			"report": "search_position_moves",
			"kind": "table",
			"w": 1,
			"title": "New queries",
			"params": {
				"list": "new"
			}
		},
		{
			"id": "wl0006",
			"report": "search_position_moves",
			"kind": "table",
			"w": 2,
			"title": "Lost queries",
			"params": {
				"list": "lost"
			}
		},
		{
			"id": "wl0007",
			"report": "search_decay",
			"kind": "table",
			"w": 3,
			"title": "Declining over three periods"
		},
		{
			"id": "wl0008",
			"report": "traffic_movers",
			"kind": "table",
			"w": 1,
			"title": "Pages with fewer views",
			"params": {
				"direction": "down"
			}
		},
		{
			"id": "wl0009",
			"report": "traffic_decay",
			"kind": "table",
			"w": 2,
			"title": "Page views declining over three periods"
