{
  "name": "@infinitnet/cookieless-analytics",
  "version": "1.4.0",
  "description": "Cookieless Analytics by Infinitnet is a self-hosted, cookieless web analytics plugin for EmDash CMS with real sessions, no cookies and a page script of about 3 KB gzipped.",
  "keywords": [
    "cookieless analytics",
    "web analytics",
    "privacy analytics",
    "cookieless tracking",
    "no cookies",
    "cookie consent",
    "gdpr",
    "eprivacy",
    "self hosted",
    "emdash",
    "emdash-plugin",
    "search console",
    "astro",
    "cloudflare workers",
    "d1",
    "tag manager",
    "dashboards",
    "revenue analytics",
    "ecommerce analytics"
  ],
  "license": "Apache-2.0",
  "author": {
    "name": "Constantin Oesterling (Infinitnet)",
    "url": "https://github.com/infinitnet"
  },
  "homepage": "https://infinitnet.io/cookieless-analytics/",
  "bugs": {
    "url": "https://github.com/infinitnet/cookieless-analytics/issues"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/infinitnet/cookieless-analytics.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./integration": {
      "types": "./dist/integration.d.mts",
      "default": "./dist/integration.mjs"
    },
    "./middleware": {
      "types": "./dist/middleware.d.mts",
      "default": "./dist/middleware.mjs"
    },
    "./contract": {
      "types": "./dist/contract.d.mts",
      "default": "./dist/contract.mjs"
    },
    "./server": {
      "types": "./dist/server.d.mts",
      "default": "./dist/server.mjs"
    },
    "./queue": {
      "types": "./dist/queue.d.mts",
      "default": "./dist/queue.mjs"
    },
    "./postgres": {
      "types": "./dist/postgres.d.mts",
      "default": "./dist/postgres.mjs"
    },
    "./admin": "./src/admin/index.tsx"
  },
  "bin": {
    "ca-data": "./scripts/ca-data.mjs"
  },
  "files": [
    "dist",
    "scripts/ca-data.mjs",
    "src",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown",
    "build:client": "tsdown --config tsdown.client.config.ts && node scripts/embed-client.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.core.json && tsc --noEmit -p tsconfig.tests-a.json && tsc --noEmit -p tsconfig.tests-mid.json && tsc --noEmit -p tsconfig.tests.json && tsc --noEmit -p tsconfig.admin.json && node scripts/check-panel-types.mjs",
    "data:agents": "node scripts/build-agent-data.mjs",
    "openapi": "node scripts/build-openapi.mjs",
    "docs:settings": "node scripts/build-settings-doc.mjs",
    "prepublishOnly": "pnpm build && pnpm test && pnpm typecheck",
    "lint:package": "publint && attw --pack . --profile esm-only"
  },
  "peerDependencies": {
    "@cloudflare/kumo": ">=2.6.0",
    "astro": "^7.0.0",
    "emdash": ">=1.4.0 <2",
    "pg": ">=8.16.3",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@cloudflare/kumo": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@electric-sql/pglite": "0.5.16",
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "astro": "^7.3.2",
    "better-sqlite3": "^13.2.0",
    "emdash": "~1.4.0",
    "jsdom": "^31.0.1",
    "kysely": "^0.29.0",
    "oxc-parser": "0.159.0",
    "publint": "^0.3.25",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsdown": "0.23.7",
    "typescript": "^7.0.2",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
